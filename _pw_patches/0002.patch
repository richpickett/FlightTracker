From 305fb8ca86d767caf8bf9cec0812a4cd4c918053 Mon Sep 17 00:00:00 2001
From: Rich Pickett <rich@personalwings.com>
Date: Fri, 7 Aug 2026 22:14:00 +0000
Subject: [PATCH 2/2] GPS: replace blocking alerts with inline toast;
 actionable Chrome un-block guidance on permission denied

---
 public/wx/index.html | 21 +++++++++++++++++++--
 1 file changed, 19 insertions(+), 2 deletions(-)

diff --git a/public/wx/index.html b/public/wx/index.html
index b9a33f3..0aceb95 100644
--- a/public/wx/index.html
+++ b/public/wx/index.html
@@ -99,6 +99,11 @@
     line-height:1.3;color:var(--txt);box-shadow:0 1px 6px #0003}
   #zoomind .zhint{font-weight:400;color:var(--dim)}
   #zoomind .zbad{color:#c0392b}
+  #gpstoast{position:fixed;left:50%;bottom:98px;transform:translateX(-50%);z-index:1002;max-width:min(92vw,430px);
+    background:#fff3f3;border:1px solid #e0a0a0;color:#7a2020;border-radius:8px;padding:8px 12px;cursor:pointer;
+    font:500 12.5px system-ui,-apple-system,sans-serif;line-height:1.4;box-shadow:0 2px 10px #0003;display:none}
+  #gpstoast.show{display:block}
+  #gpstoast b{color:#5a1414}
   /* METAR markers */
   .stn{border-radius:6px;border:1.5px solid #fff;box-shadow:0 0 0 1px #0009;font:700 10px/1 -apple-system,Arial;
        color:#04121f;padding:2px 4px;white-space:nowrap;text-align:center}
@@ -118,6 +123,7 @@
 <body>
 <div id="map"></div>
 <div id="zoomind">z—</div>
+<div id="gpstoast"></div>
 
 <div id="hdr">
   <a href="/" class="hubback">← Ops Hub</a>
@@ -660,8 +666,12 @@ function osIcon(hdg){
     html:'<svg class="ownship" width="30" height="30" viewBox="0 0 30 30"><g transform="rotate('+rot+' 15 15)">'+
       '<polygon points="15,2 23,26 15,20 7,26" fill="#00e0ff" stroke="#00323b" stroke-width="1.2"/></g></svg>'});
 }
+var _gpsT;
+function gpsMsg(msg){ var t=document.getElementById("gpstoast"); if(!t) return;
+  t.innerHTML=msg; t.classList.add("show"); t.onclick=function(){ t.classList.remove("show"); };
+  clearTimeout(_gpsT); _gpsT=setTimeout(function(){ t.classList.remove("show"); },12000); }
 function startGPS(){
-  if(!navigator.geolocation){ alert('Geolocation not supported here.'); return; }
+  if(!navigator.geolocation){ gpsMsg("Geolocation isn't supported in this browser."); return; }
   document.getElementById('gps').classList.add('on');
   watchId=navigator.geolocation.watchPosition(function(pos){
     var c=pos.coords, ll=[c.latitude,c.longitude];
@@ -674,7 +684,14 @@ function startGPS(){
       (c.altitude!=null?('<br>GPS alt '+Math.round(c.altitude*3.28084)+'′'):'')+
       (c.heading!=null&&!isNaN(c.heading)?('<br>Trk '+Math.round(c.heading)+'°'):''));
     if(followOn){ map.panTo(ll,{animate:false}); }
-  }, function(err){ alert('GPS: '+err.message); stopGPS(); },
+  }, function(err){
+    var m;
+    if(err.code===1) m="Location is <b>blocked</b> for this site. In Chrome, click the tune/site-info icon at the left of the address bar → <b>Location</b> → <b>Allow</b> (or Site settings → Location → Allow), then reload and tap ◎ GPS again.";
+    else if(err.code===2) m="GPS position unavailable — no fix yet. Near a window, or with device Location Services on, usually helps.";
+    else if(err.code===3) m="GPS timed out getting a fix. Tap ◎ GPS to retry.";
+    else m="GPS error: "+(err.message||"unknown");
+    gpsMsg(m); stopGPS();
+  },
   {enableHighAccuracy:true,maximumAge:2000,timeout:20000});
 }
 function stopGPS(){ if(watchId!=null){ navigator.geolocation.clearWatch(watchId); watchId=null; }
-- 
