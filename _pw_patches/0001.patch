From 63801532a70217cedf8c522440a6f7677c7eb3f5 Mon Sep 17 00:00:00 2001
From: Rich Pickett <rich@personalwings.com>
Date: Fri, 7 Aug 2026 22:07:23 +0000
Subject: [PATCH 1/2] Map: highlight+wrap zoom-legend box (no panel overlap);
 lock Track tail on shared maps (still tracks)

---
 public/wx/index.html | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/public/wx/index.html b/public/wx/index.html
index 3f71dab..b9a33f3 100644
--- a/public/wx/index.html
+++ b/public/wx/index.html
@@ -34,6 +34,7 @@
   #hdr{max-width:min(92vw,440px)}
   #hdr .brand>div{min-width:0}
   body.shared #routein, body.shared #plotbtn, body.shared #newbtn, body.shared a.hubback[href="/"]{display:none!important}
+  body.shared #regin{background:#eef1f6!important;color:var(--dim)!important;cursor:default;opacity:.9}
   /* Controls panel */
   #ctl{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);z-index:1000;width:min(98vw,1024px);
        background:var(--panel);backdrop-filter:blur(6px);border:1px solid var(--line);border-radius:12px;padding:10px 12px}
@@ -92,9 +93,10 @@
   #legend .bar{height:10px;border-radius:2px;margin:3px 0 1px;border:1px solid #0000000f}
   #legend .ticks{display:flex;justify-content:space-between;color:var(--dim);font-size:9px;margin-top:1px}
   .note{color:var(--dim);font-size:10px;margin-top:5px;line-height:1.35}
-  #zoomind{position:fixed;left:10px;bottom:22px;z-index:1000;background:var(--panel);backdrop-filter:blur(6px);
-    border:1px solid var(--line);border-radius:8px;padding:3px 8px;font:600 12px ui-monospace,Menlo,Consolas,monospace;
-    color:var(--txt);box-shadow:0 1px 4px #0002}
+  #zoomind{position:fixed;left:10px;bottom:22px;z-index:1001;max-width:150px;white-space:normal;overflow-wrap:anywhere;
+    background:#fff7e6;backdrop-filter:blur(6px);
+    border:1px solid #e8b84b;border-radius:8px;padding:4px 9px;font:600 12px ui-monospace,Menlo,Consolas,monospace;
+    line-height:1.3;color:var(--txt);box-shadow:0 1px 6px #0003}
   #zoomind .zhint{font-weight:400;color:var(--dim)}
   #zoomind .zbad{color:#c0392b}
   /* METAR markers */
@@ -776,7 +778,7 @@ Promise.all([_pwJSON('airports.json'),_pwJSON('navaids.json'),_pwJSON('fixes.jso
   if(urlReg||savedReg) regExplicit=true;
   REG=((urlReg||savedReg||'').toUpperCase().replace(/[^A-Z0-9]/g,''));
   var rg=document.getElementById('regin'); if(rg) rg.value=REG;
-  if(new URLSearchParams(location.search).get('ac')){ document.body.classList.add('shared'); startADSB(); }
+  if(new URLSearchParams(location.search).get('ac')){ document.body.classList.add('shared'); var lk=document.getElementById('regin'); if(lk){ lk.readOnly=true; lk.title='Tracking '+(REG||'aircraft')+' — locked on shared map'; } startADSB(); }
   setRouteMsg(Object.keys(AIRPORTS).length.toLocaleString()+' airports · '+Object.keys(DB.fixes).length.toLocaleString()+' fixes · '+Object.keys(DB.airways).length.toLocaleString()+' airways');
   if(initRoute) plotRoute(initRoute);
   resetAdsb(); if(map.hasLayer(adsbGroup)) fetchADSB();
